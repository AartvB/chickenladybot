{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "chickenbotonceaday",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "settings": {
    "global": {
      "discordBotToken": {
        "type": "string",
        "label": "Discord Bot Token",
        "isSecret": true
      },
      "discordNewPostChannelId": {
        "type": "string",
        "label": "Discord New Post Channel ID",
        "defaultValue": "1374663841052626975"
      },
      "discordDailyBotPostChannelId": {
        "type": "string",
        "label": "Discord Daily Bot Post Channel ID",
        "defaultValue": "1374672239038955613"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Toggle shutdown",
        "description": "Activate or deactivate shutdown mode. In shutdown mode, the bot will stop processing any new posts.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/toggle-shutdown"
      },
      {
        "label": "Add post to streak database",
        "description": "Add this post to the streak database.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/add-post-to-streak-database"
      },
      {
        "label": "Remove post from streak database",
        "description": "Remove this post from the streak database.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/remove-post-from-streak-database"
      },
      {
        "label": "Add manual streak",
        "description": "Add a manual streak for a user.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/add-manual-streak"
      },
      {
        "label": "View streak development",
        "description": "View the development of streak over time. Works best on mobile.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-streak-development"
      },
      {
        "label": "Post as bot",
        "description": "Make a post as the bot.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-as-bot"
      },
      {
        "label": "Edit bot post",
        "description": "Edit a post made by the bot.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/edit-bot-post"
      },
      {
        "label": "View bot post info",
        "description": "View information about a post made by the bot.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-bot-post-info"
      },
      {
        "label": "Comment as bot",
        "description": "Make a comment as the bot.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/comment-as-bot"
      },
      {
        "label": "Comment as bot",
        "description": "Make a comment as the bot.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/comment-as-bot"
      },
      {
        "label": "Edit bot comment",
        "description": "Edit a comment made by the bot.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/edit-bot-comment"
      },
      {
        "label": "View bot comment info",
        "description": "View information about a comment made by the bot.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-bot-comment-info"
      }
    ]
  },
  "forms": {
    "deactivateHardShutdown": "/internal/form/deactivate-hard-shutdown",
    "handleSoftShutdown": "/internal/form/handle-soft-shutdown",
    "activateShutdown": "/internal/form/activate-shutdown",
    "addPostToStreakDatabase": "/internal/form/add-post-to-streak-database",
    "removePostFromStreakDatabase": "/internal/form/remove-post-from-streak-database",
    "addManualStreak": "/internal/form/add-manual-streak",
    "viewStreakDevelopment": "/internal/form/view-streak-development",
    "displayStreakDevelopment": "/internal/form/display-streak-development",
    "postAsBot": "/internal/form/post-as-bot",
    "editBotPost": "/internal/form/edit-bot-post",
    "viewBotPostInfo": "/internal/form/view-bot-post-info",
    "commentAsBot": "/internal/form/comment-as-bot",
    "editBotComment": "/internal/form/edit-bot-comment",
    "viewBotCommentInfo": "/internal/form/view-bot-comment-info"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "scheduler": {
    "tasks": {
      "new-post-handler": {
        "endpoint": "/internal/tasks/new-post-handler",
        "cron": "*/2 * * * * *"
      },
      "streak-handler": {
        "endpoint": "/internal/tasks/streak-handler",
        "cron": "*/5 * * * * *"
      },
      "deleted-post-handler": {
        "endpoint": "/internal/tasks/deleted-post-handler",
        "cron": "*/10 * * * * *"
      },
      "background-task-handler": {
        "endpoint": "/internal/tasks/background-task-handler",
        "cron": "*/15 * * * * *"
      },
      "discord-handler": {
        "endpoint": "/internal/tasks/discord-handler",
        "cron": "*/30 * * * * *"
      }
    }
  },
  "permissions": {
    "reddit": true,
    "redis": true,
    "http": {
      "enable": true,
      "domains": ["discord.com"]
    }
  },
  "dev": {
    "subreddit": "chickenladybot_dev"
  }
}