{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "chickenladybot",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Mop comments",
        "description": "Remove this comment and all child comments. This might take a few seconds to run.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-comment"
      },
      {
        "label": "Mop post comments",
        "description": "Remove all comments of this post. This might take a few seconds to run.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-post"
      }
    ]
  },
  "forms": {},
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "scheduler": {
    "tasks": {
      "new-post-handler": {
        "endpoint": "/internal/tasks/new-post-handler",
        "cron": "*/2 * * * * *"
      },
      "streak-handler": {
        "endpoint": "/internal/tasks/streak-handler",
        "cron": "*/5 * * * * *"
      }
    }
  },
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "dev": {
    "subreddit": "chickenladybot_dev"
  }
}